<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Color Palette Tokens -->
    <Color x:Key="Primary">#8b5cf6</Color>
    <Color x:Key="Secondary">#6d28d9</Color>
    <Color x:Key="Background">#050505</Color>
    <Color x:Key="Surface">#0c0c14</Color>
    
    <Color x:Key="Gray100">#e2e8f0</Color>
    <Color x:Key="Gray200">#cbd5e1</Color>
    <Color x:Key="Gray500">#64748b</Color>
    <Color x:Key="Gray600">#475569</Color>
    
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <!-- Brush Tokens -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    
</ResourceDictionary>
